{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cco.dev/schemas/benchmark-suite.schema.json",
  "title": "BenchmarkSuite",
  "type": "object",
  "required": [
    "suiteId",
    "version",
    "taskFamily",
    "trials",
    "tolerance",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "suiteId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "taskFamily": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "trials": {
      "type": "integer",
      "minimum": 1
    },
    "tolerance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "validators"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "validators": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
