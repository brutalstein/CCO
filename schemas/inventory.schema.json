{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cco.dev/schemas/inventory.schema.json",
  "title": "InventorySnapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "capturedAt",
    "claude",
    "plugins",
    "standalone",
    "constraints",
